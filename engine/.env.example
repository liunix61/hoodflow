# HoodFlow Environment Variables

# ===== Robinhood Chain配置 =====
ROBINHOOD_CHAIN_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
ROBINHOOD_CHAIN_PRIVATE_KEY="0x..."

# ===== MCP Server配置（可选）=====
# MCP_SERVER_PORT=8000
# MCP_SERVER_HOST=0.0.0.0

# ===== 做市商配置 =====
MIN_PROFIT_MARGIN=0.01
RISK_TOLERANCE=0.8
MIN_LIQUIDITY_THRESHOLD=0.1

# ===== 套利配置 =====
MAX_ARBITRAGE_PROFIT=0.03
MAX_SLIPPAGE=0.01
MAX_CONCURRENT_TRADES=10
CHECK_INTERVAL_MS=500

# ===== 治理配置 =====
VOTING_DELAY=3600
VOTING_PERIOD=604800
PROPOSAL_THRESHOLD=1000000000000000000

# ===== 经济模型配置 =====
TOTAL_SUPPLY=1000000000
INITIAL_LIQUIDITY=2000000000000000000
FEE_RATE=0.02
FEE_BURN_RATE=0.5

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=hoodflow.log

# ===== 测试配置 =====
TEST_NETWORK="robinhood-testnet"
TEST_PRIVATE_KEY="0x..."
